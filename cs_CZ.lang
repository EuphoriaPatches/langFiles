option.GR_GR=Zelená do červené
option.GR_GG=Zelená do zelené
option.GR_GB=Zelená do modré
option.GR_GC=Křivka zelené
option.GR_BR=Modrá do červené
option.GR_BG=Modrá do zelené
option.GR_BB=Modrá do modré
option.GR_BC=Křivka modré

